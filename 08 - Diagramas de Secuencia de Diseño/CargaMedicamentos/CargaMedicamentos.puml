@startuml
title Carga de Medicamentos

hide footbox

actor "Administrador:Admin" as admin
participant "gc:FarmaciaControlador" as ctrl
participant "cat:<<Singleton>>\nCatalogoMedicamentos" as cat
participant "listaMed[i]:Medicamento" as med_actual
collections "<<multiobjeto>>\nlistaMed:List" as lista_med

admin -> ctrl : registrarMedicamento(codigoBarra: int, nombre: String, drogueriaNombre: String, precioUnitario: float, stock: int)
activate ctrl

ctrl -> cat : buscarMedicamento(codigoBarra : int)
activate cat

loop para cada Medicamento en listaMed
    cat -> med_actual : getCodigoBarra()
    activate med_actual
    med_actual --> cat : <<codActual : int>>
    
    deactivate med_actual
end

cat --> ctrl : <<medEncontrado : Medicamento>>
deactivate cat

alt Se encontró el Medicamento
    
    ctrl --> admin : "Error: Medicamento ya registrado"

else No se pudo encontrar el Medicamento
    
    create participant "nuevoMed:Medicamento" as nuevo_med
    ctrl -> nuevo_med : CrearMedicamento(codigoBarra: int, nombre: String, drogueriaNombre: String, precioUnitario: float, stock: int)
    activate nuevo_med
    nuevo_med --> ctrl : <<nuevoMed : Medicamento>>
    deactivate nuevo_med

    ctrl -> cat : agregarMedicamento(nuevoMed : Medicamento)
    activate cat
    
    cat -> lista_med : add(nuevoMed : Medicamento)
    activate lista_med
    lista_med --> cat : <<null>>
    deactivate lista_med
    
    cat --> ctrl : <<null>>
    deactivate cat
    
    ctrl --> admin : "Éxito: Medicamento guardado"
    deactivate ctrl
end
@enduml