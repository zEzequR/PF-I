@startuml
title Carga de Tipo de Descuento
hide footbox

actor "Administrador:Admin" as admin
participant "gc:FarmaciaControlador" as ctrl
participant "cat:<<Singleton>>\nCatalogoDescuentos" as cat
participant "listaDesc[i]:TipoDescuento" as listDesc
collections "<<multiobjeto>>\nlistaDesc:List" as lista_desc

admin -> ctrl : registrarTipoDescuento(motivo: String, porcentaje: Float, fechaInicio: Date, fechaFin: Date)
activate ctrl

ctrl -> cat : buscarDescuento(motivo : String)
activate cat

loop para cada TipoDescuento en listaDesc
    cat -> listDesc : getMotivo()
    activate listDesc
    listDesc --> cat : <<motivoActual : String>>
    
    deactivate listDesc
end

cat --> ctrl : <<descuentoEncontrado : TipoDescuento>>
deactivate cat

alt Se encontró al Tipo de Descuento
    
    ctrl --> admin : "Error: Tipo de descuento ya registrado"

else No se pudo encontrar al Tipo de Descuento
    
    create participant "nuevoTD:TipoDescuento" as td
    ctrl -> td : CrearTipoDescuento(motivo: String, porcentaje: Float, fechaInicio: Date, fechaFin: Date)
    activate td
    td --> ctrl : <<nuevoTD : TipoDescuento>>
    deactivate td
    
    ctrl -> cat : agregarDescuento(nuevoTD : TipoDescuento)
    activate cat
    
    cat -> lista_desc : add(nuevoTD : TipoDescuento)
    activate lista_desc
    lista_desc --> cat : <<null>>
    deactivate lista_desc
    
    cat --> ctrl : <<null>>
    deactivate cat
    
    ctrl --> admin : "Éxito: Descuento guardado"
    deactivate ctrl

end
@enduml