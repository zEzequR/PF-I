@startuml
!pragma teoz true
hide footbox
title Venta Sin Receta

actor "emp:Empleado" as emp
participant "cv:ControladorVentas" as cv
participant "cc:<<Singleton>>\nCatalogoClientes" as cc
participant "listaC[i]:Cliente" as itemCli
participant "cli:Cliente" as cli
participant "vta:Venta" as vta
participant "cm:<<Singleton>>\nCatalogoMedicamentos" as cm
participant "listaM[j]:Medicamento" as itemMed
participant "med:Medicamento" as med
participant "det:DetalleVenta" as det
collections "«multiobjeto»\ndetalles:DetalleVenta" as lineas

' =================================================================
' 1. INICIO Y CREACIÓN DE VENTA
' =================================================================
emp -> cv : iniciarNuevaVenta(dniCliente : INT)
activate cv

cv -> cc : buscarCliente(dniCliente : INT)
activate cc
loop Para cada Cliente en listaC
    cc -> itemCli : getDNI()
    activate itemCli
    itemCli --> cc : <<dniGuardado : INT>>
    deactivate itemCli
end
cc --> cv : << cli : Cliente>>
deactivate cc

alt No se encontró al Cliente
    cv --> emp : <<"El cliente no se encontró">>
    note over of cv: Si el empleado decide crear un nuevo cliente,\n se ejecuta los pasos del diagrama 'CargaClientes'
else Se encontró el Cliente
    create vta
    cv -> vta : CrearVenta(nroVta : INT, cli : Cliente, usuario : Usuario, fecha : Date)
    activate vta
    vta --> cv : << NULL >>
    deactivate vta
    cv --> emp : "Éxito: Venta creada"
    deactivate cv
end

' =================================================================
' 2. AGREGAR PRODUCTO
' =================================================================
emp -> cv : escanearProducto(codBarra : INT, cantidad : INT)
activate cv

cv -> cm : buscarMedicamento(codBarra : INT)
activate cm
loop hasta cod == codBarra
    cm -> itemMed : getCodigoBarra()
    activate itemMed
    itemMed --> cm : <<cod : INT>>
    deactivate itemMed
end
cm --> cv : << med : Medicamento>>
deactivate cm

alt No se encontró el medicamento
    cv --> emp : <<"Medicamento no encontrado">>
else Medicamento encontrado
    cv -> vta : agregarDetalle(med : Medicamento, cantidad : INT)
    activate vta
    
    Create det
    vta -> det : CrearDetalleVenta(med : Medicamento, cantidad : INT)
    activate det
    det --> vta : <<det : DetalleVenta>>
    deactivate det

    vta -> lineas : add(det : DetalleVenta)
    activate lineas
    lineas --> vta : <<NULL>>
    deactivate lineas
    
    vta --> cv : <<NULL>>
    deactivate vta
    
    cv --> emp : "Producto agregado"
    deactivate cv
end
@enduml