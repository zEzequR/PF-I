@startuml
!pragma teoz true
hide footbox
title Eliminación de Medicamentos

actor "Administrador:Admin" as admin
participant "gc:GestionControlador" as gc
participant "catMed:<<Singleton>>\nCatalogoMedicamentos" as catMed
participant "listaMed[i]:Medicamento" as arrayMed
collections "<<multiobjeto>>\nlistaMed:List" as lista_med
participant "catVentas:<<Singleton>>\nCatalogoVentas" as catVentas
participant "listaVentas[j]:Venta" as arrayVentas
participant "detalles[k]:DetalleVenta" as arrayDetalles

admin -> gc : eliminarMedicamento(codBarra : int)
activate gc

gc -> catMed : buscarMedicamento(codBarra : int)
activate catMed

loop hasta codBarra == codActual
    catMed -> arrayMed : getCodigoBarra()
    activate arrayMed
    arrayMed --> catMed : <<codActual : int>>
    
    note right of arrayMed : Si no se encuentra, retornar null
    
    deactivate arrayMed
end

catMed --> gc : <<medEncontrado : Object Type : Medicamento>>
deactivate catMed


alt medEncontrado == null
    
    gc --> admin : "Error: El medicamento no existe"
    
else medEncontrado != null
    
    note right of gc
        vtaAsociada = FALSE
    end note
    
    loop para cada v en listaVentas
        
        gc -> arrayVentas : getDetallesDeVenta()
        activate arrayVentas
        arrayVentas --> gc : <<listaDetalles : List<DetalleVenta>>>
        deactivate arrayVentas
        
        loop para cada d en listaDetalles
            gc -> arrayDetalles : getCodigoBarra()
            activate arrayDetalles
            arrayDetalles --> gc : <<codDetalle : int>>
            deactivate arrayDetalles
            
            alt codDetalle == codBarra
                note right of gc
                    vtaAsociada = TRUE
                end note
            else codDetalle != codBarra
                note right of gc
                    vtaAsociada = FALSE
                end note
            end
            
        end
    end

    alt vtaAsociada == TRUE
        
        gc --> admin : "Error: No se puede eliminar porque el medicamento tiene ventas asociadas"
        
    else vtaAsociada == FALSE
        
        gc -> catMed : eliminarMedicamento(medEncontrado : Object Type : Medicamento)
        activate catMed
        
        catMed -> lista_med : remove(medEncontrado : Object Type : Medicamento)
        activate lista_med
        lista_med --> catMed : <<null>>
        deactivate lista_med
        
        catMed --> gc : <<null>>
        deactivate catMed
        
        gc --> admin : "Medicamento eliminado exitosamente"
        
    end

end

deactivate gc
@enduml