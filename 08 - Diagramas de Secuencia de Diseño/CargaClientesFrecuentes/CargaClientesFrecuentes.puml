@startuml
title Carga de clientes frecuentes

hide footbox

actor "Administrador:Admin" as admin
participant "gc:GestionControlador" as ctrl
participant "cat:<<Singleton>>\nCatalogoClientes" as cat
participant "listaClientes[i]:Cliente" as item
participant "clienteEncontrado:Cliente" as cli_encontrado

admin -> ctrl : registrarClienteFrecuente(dni: String)
activate ctrl

ctrl -> cat : buscarCliente(dni : String)
activate cat

loop hasta dni == dniActual
    cat -> item : getDni()
    activate item
    item --> cat : <<dniActual : String>>
    
    note right of item : Si no se encuentra, retornar null
    
    deactivate item
end

cat --> ctrl : <<clienteEncontrado : Cliente>>
deactivate cat

alt clienteEncontrado == null
    
    ctrl --> admin : "Error: Cliente no registrado"

else clienteEncontrado != null

    ctrl -> cli_encontrado : getMontoAcumulado()
    activate cli_encontrado
    cli_encontrado --> ctrl : <<monto : Float>>
    deactivate cli_encontrado
    
    alt monto >= 400000
        ctrl -> cli_encontrado : setEsFrecuente(true)
        activate cli_encontrado
        cli_encontrado --> ctrl : <<null>> 
        deactivate cli_encontrado
        
        ctrl --> admin : "Éxito: Cliente actualizado a Frecuente"
        
    else monto < 400000
        ctrl --> admin : "Error: No cumple con el monto ($400.000)"
    end

end

deactivate ctrl
@enduml