@startuml
title Control e Informe

hide footbox

actor "Administrador" as admin
participant "gc:FarmaciaControlador" as ctrl
participant "catV:<<Singleton>>\nCatalogoVentas" as cat_ventas
participant "listaVenta[i]: Venta" as venta 
participant "catM:<<Singleton>>\nCatalogoMedicamentos" as cat_med
participant "listaMed[k]: Medicamento" as med
participant "gen:GeneradorReportes" as gen
participant "sc:ServicioCorreos" as srv_mail

admin -> ctrl : solicitarInforme(tipoInforme: String, filtro: String)
activate ctrl

alt tipo == "VENTAS"
    ctrl -> cat_ventas : obtenerVentasPorFecha(fecha: Date)
    activate cat_ventas
    
    loop Para cada Venta en listaVenta
        cat_ventas -> venta : getFecha()
        activate venta
        venta --> cat_ventas : << fechaRegistrada: Date >>
        deactivate venta
    end
    cat_ventas --> ctrl : << ventasEncontradas : List<Venta> >>
    deactivate cat_ventas
    alt No se pudo encontrar las Ventas (Lista Vacia)
        ctrl --> admin : << listaVentas: List<NULL> >>
    else Se encontraron las Ventas
        ctrl --> admin : << listaVentas: List<Venta> >>
    end

else tipo == "STOCK"
    ctrl -> cat_med : buscarMedicamentos(filtro: String)
    activate cat_med
    
    loop hasta filtro = nombre
        cat_med -> med : getNombre()
        activate med
        med --> cat_med : << nombre: String >>
        deactivate med
    end

    cat_med --> ctrl : << medicamentosEncontrados : List<Medicamento> >>
    deactivate cat_med

    alt medicamentosEncontrados == null
        ctrl --> admin : << "Sin resultados" >>
    else medicamentosEncontrados != null
        ctrl --> admin : << medicamentosEncontrados : List<Medicamento> >>
    end
end

opt El administrador decide exportar
    admin -> ctrl : procesarInforme(listaDatos: List, accion: String)

    ctrl -> gen : generarPDF(listaDatos: List)
    activate gen
    gen --> ctrl : << archivoGenerado: File >>
    deactivate gen

    alt accion == "GUARDAR"
        ctrl --> admin : << "Éxito: Se ha guardado el archivo localmente">>
        
    else accion == "ENVIAR_PROVEEDOR"
        ctrl -> srv_mail : enviarCorreo(archivoGenerado: File, emailProv: String)
        activate srv_mail
        srv_mail --> ctrl : << respuesta :  bool >>
        deactivate srv_mail
        
        alt respuesta = false
            ctrl --> admin : << "Error: Falló el envío" >>
        else respuesta = true
            ctrl --> admin : << "Éxito: Informe enviado" >>
            deactivate ctrl
        end
        
    end
end

@enduml